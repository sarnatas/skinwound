# --- OS / editor ---
.DS_Store
**/.DS_Store
__MACOSX/
.vscode/
.idea/

# --- notebooks: session state / caches ---
__marimo__/
.ipynb_checkpoints/
__pycache__/
*.pyc

# --- raw / large data: never commit (GitHub limit = 100 MB per file) ---
# Students download the published data from GEO (see data/README.md)
data/*
!data/README.md

# --- large intermediate objects ---
*.h5ad
*.zarr/
*.rds
*.h5
*.loom

# --- Quarto site (built by GitHub Actions, never committed) ---
_site/
.quarto/
/.jupyter_cache/

# --- ens-ngs mock alignment: keep only make_toy_data.py, alignment_mock.sh, README ---
# Toy data live on the course server; regenerate them with make_toy_data.py
ens-ngs/alignment_mock/toy_data/
ens-ngs/alignment_mock/toy_data.zip
# Space Ranger outputs (spaceranger count --id=<sample> writes ./<sample>/ in the cwd)
ens-ngs/alignment_mock/Skin/
ens-ngs/alignment_mock/Wound1/
ens-ngs/alignment_mock/Wound7/
ens-ngs/alignment_mock/Wound30/
ens-ngs/alignment_mock/mock_output/
ens-ngs/alignment_mock/__*/
ens-ngs/alignment_mock/*.mri.tgz

# --- R ---
.Rhistory

# --- slides: only the PDF is versioned, not the PowerPoint source ---
ens-ngs/slides/*.pptx
ens-ngs/notebooks/Analysis.ipynb
